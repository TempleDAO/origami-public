contract OrigamiBundlerPluginKyberSwapTestBase is OrigamiTest, OrigamiBundlerTestUtils {
    address public constant ROUTER_V2 = 0x6131B5fae19EA4f9D964eAc0408E4408b66337b5;
    address public constant SCALING_HELPER = 0x2f577A41BeC1BE1152AeEA12e73b7391d15f655D;

    address public constant WETH_HOLDER = 0x8EB8a3b98659Cce290402893d0123abb75E3ab28;
    address public constant WETH_TOKEN = 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2;
    address public constant USDC_TOKEN = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;

    OrigamiBundler internal bundler;
    OrigamiBundlerPluginKyberSwap internal plugin;

    function setUp() public {
        fork("mainnet", 23_617_039);
        bundler = new OrigamiBundler();
        plugin = new OrigamiBundlerPluginKyberSwap(origamiMultisig, ROUTER_V2, SCALING_HELPER);

        vm.startPrank(origamiMultisig);
        plugin.setBundlerApproved(address(bundler), true);
        vm.stopPrank();
    }
}

contract OrigamiBundlerPluginKyberSwapTestAdmin is OrigamiBundlerPluginKyberSwapTestBase {
    function test_initialization() public view {
        assertEq(plugin.owner(), origamiMultisig);
        assertTrue(plugin.isApprovedBundler(address(bundler)));
        assertFalse(plugin.isApprovedBundler(alice));
        assertEq(plugin.ROUTER(), ROUTER_V2);
        assertEq(plugin.SCALING_HELPER(), SCALING_HELPER);
    }

    function test_supportsInterface() public view {
        assertTrue(plugin.supportsInterface(type(IOrigamiBundlerPluginKyberSwap).interfaceId));
        assertTrue(plugin.supportsInterface(type(IOrigamiBundlerPluginMultiAccess).interfaceId));
        assertTrue(plugin.supportsInterface(type(IOrigamiBundlerPlugin).interfaceId));
        assertTrue(plugin.supportsInterface(type(IERC165).interfaceId));
        assertTrue(plugin.supportsInterface(type(IOrigamiElevatedAccess).interfaceId));
        assertFalse(plugin.supportsInterface(type(IERC20).interfaceId));
    }
}

contract OrigamiBundlerPluginKyberSwapTestAccess is OrigamiBundlerPluginKyberSwapTestBase {
    function test_access_swap() public {
        checkInvalidBundler(alice);
        plugin.swap(alice, "");

        checkInvalidBundler(origamiMultisig);
        plugin.swap(alice, "");
    }

    function test_access_swapBalance() public {
        checkInvalidBundler(alice);
        plugin.swapBalance(alice, "");

        checkInvalidBundler(origamiMultisig);
        plugin.swapBalance(alice, "");
    }
}

contract OrigamiBundlerPluginKyberSwapTest is OrigamiBundlerPluginKyberSwapTestBase {
    event Swapped(
        address caller, address fromToken, address toToken, address receiver, uint256 fromAmount, uint256 toAmount
    );

    function getCalldataNonScaled() internal pure returns (bytes memory callData) {
        // calldata prepared via Kyber API:
        /**
         * curl
         * 'https://aggregator-api.kyberswap.com/ethereum/api/v1/routes?tokenIn=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2&tokenOut=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48&amountIn=10000000000000000000&onlyScalableSources=false&onlySinglePath=true&gasInclude=true&onlyDirectPools=true'
         * | jq
         *
         * curl https://aggregator-api.kyberswap.com/ethereum/api/v1/route/build \
         * --request POST \
         * --header 'Content-Type: application/json' \
         * --data '{
         *     $ROUTE_SUMMARY
         * },
         * "sender": "0xCe01C90dE7FD1bcFa39e237FE6D8D9F569e8A6a3",
         * "recipient": "0x8EB8a3b98659Cce290402893d0123abb75E3ab28",
         * "slippageTolerance": 100
         * }' | jq
         */

        // Note Since the recipient in the API is the WETH_HOLDER, the tokens go there
        // Cant change the recipient in the calldata as there's a signature recovery
        callData = hex"e21fd0e9";
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
    }

    function getCalldataScaled() internal pure returns (bytes memory callData) {
        // calldata prepared via Kyber API:
        /**
         * curl
         * 'https://aggregator-api.kyberswap.com/ethereum/api/v1/routes?tokenIn=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2&tokenOut=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48&amountIn=10000000000000000000&onlyScalableSources=true&onlySinglePath=true&gasInclude=true&onlyDirectPools=true'
         * | jq
         *
         * curl https://aggregator-api.kyberswap.com/ethereum/api/v1/route/build \
         * --request POST \
         * --header 'Content-Type: application/json' \
         * --data '{
         *     "routeSummary": {
         *         $ROUTE_SUMMARY
         *     },
         * "sender": "0xCe01C90dE7FD1bcFa39e237FE6D8D9F569e8A6a3",
         * "recipient": "0x8EB8a3b98659Cce290402893d0123abb75E3ab28",
         * "slippageTolerance": 500
         * }' | jq
         */

        // Note Since the recipient in the API is the WETH_HOLDER, the tokens go there
        // Cant change the recipient in the calldata as there's a signature recovery
        callData = hex"e21fd0e9";
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
        callData = bytes.concat(
            callData,
            hex""
        );
    }

    function test_swap_failNotEnoughBal() public {
        deal(WETH_TOKEN, address(plugin), 10e18 - 1);
        vm.startPrank(address(bundler));
        vm.expectRevert("TransferHelper: TRANSFER_FROM_FAILED");
        plugin.swap(WETH_TOKEN, getCalldataNonScaled());
    }

    function test_swap_success() public {
        deal(WETH_TOKEN, address(plugin), 10e18);
        vm.startPrank(address(bundler));

        uint256 startingWethBal = IERC20(WETH_TOKEN).balanceOf(WETH_HOLDER);
        uint256 startingUsdcBal = IERC20(USDC_TOKEN).balanceOf(WETH_HOLDER);

        uint256 expectedUsdcReceived = 40_711.521551e6;
        vm.expectEmit();
        emit Swapped(address(plugin), WETH_TOKEN, USDC_TOKEN, WETH_HOLDER, 10e18, expectedUsdcReceived);
        plugin.swap(WETH_TOKEN, getCalldataNonScaled());

        assertEq(IERC20(WETH_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(WETH_TOKEN).balanceOf(address(WETH_HOLDER)) - startingWethBal, 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(WETH_HOLDER)) - startingUsdcBal, expectedUsdcReceived);
        assertEq(IERC20(WETH_TOKEN).allowance(address(plugin), ROUTER_V2), type(uint256).max);
    }

    function test_swap_tooMuchBal() public {
        // 1 extra WETH in the plugin -- still only the 10 WETH is sold.
        deal(WETH_TOKEN, address(plugin), 11e18);
        vm.startPrank(address(bundler));

        uint256 startingWethBal = IERC20(WETH_TOKEN).balanceOf(WETH_HOLDER);
        uint256 startingUsdcBal = IERC20(USDC_TOKEN).balanceOf(WETH_HOLDER);

        uint256 expectedUsdcReceived = 40_711.521551e6;
        vm.expectEmit();
        emit Swapped(address(plugin), WETH_TOKEN, USDC_TOKEN, WETH_HOLDER, 10e18, expectedUsdcReceived);
        plugin.swap(WETH_TOKEN, getCalldataNonScaled());

        assertEq(IERC20(WETH_TOKEN).balanceOf(address(plugin)), 1e18);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(WETH_TOKEN).balanceOf(address(WETH_HOLDER)) - startingWethBal, 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(WETH_HOLDER)) - startingUsdcBal, expectedUsdcReceived);
        assertEq(IERC20(WETH_TOKEN).allowance(address(plugin), ROUTER_V2), type(uint256).max);
    }

    function test_swapBalance_scalingFailed() public {
        deal(WETH_TOKEN, address(plugin), 11e18);
        vm.startPrank(address(bundler));
        vm.expectRevert(abi.encodeWithSelector(IOrigamiBundlerPluginKyberSwap.ScalingFailed.selector));
        plugin.swapBalance(WETH_TOKEN, getCalldataNonScaled());
    }

    function test_swapBalance_scalingEmptyCalldataFailed() public {
        bytes memory emptyBytes = hex"";
        vm.mockCall(
            address(SCALING_HELPER),
            abi.encodeWithSelector(IKyberScalingHelper.getScaledInputData.selector),
            abi.encode(true, emptyBytes)
        );

        deal(WETH_TOKEN, address(plugin), 10.5e18);
        vm.startPrank(address(bundler));

        vm.expectRevert(abi.encodeWithSelector(IOrigamiBundlerPluginKyberSwap.ScalingFailed.selector));
        plugin.swapBalance(WETH_TOKEN, getCalldataScaled());
    }

    function test_swapBalance_successOver() public {
        // Deal more than the original quote (10.5 WETH vs quoted 10 WETH)
        deal(WETH_TOKEN, address(plugin), 10.5e18);
        vm.startPrank(address(bundler));

        uint256 startingWethBal = IERC20(WETH_TOKEN).balanceOf(WETH_HOLDER);
        uint256 startingUsdcBal = IERC20(USDC_TOKEN).balanceOf(WETH_HOLDER);

        uint256 expectedUsdcReceived = 42_629.095689e6;
        vm.expectEmit();
        emit Swapped(address(plugin), WETH_TOKEN, USDC_TOKEN, WETH_HOLDER, 10.5e18, expectedUsdcReceived);
        plugin.swapBalance(WETH_TOKEN, getCalldataScaled());

        assertEq(IERC20(WETH_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(WETH_TOKEN).balanceOf(address(WETH_HOLDER)) - startingWethBal, 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(WETH_HOLDER)) - startingUsdcBal, expectedUsdcReceived);
        assertEq(IERC20(WETH_TOKEN).allowance(address(plugin), ROUTER_V2), type(uint256).max);
    }

    function test_swapBalance_successUnder() public {
        // Deal less than the original quote (9.5 WETH vs quoted 10 WETH)
        deal(WETH_TOKEN, address(plugin), 9.5e18);
        vm.startPrank(address(bundler));

        uint256 startingWethBal = IERC20(WETH_TOKEN).balanceOf(WETH_HOLDER);
        uint256 startingUsdcBal = IERC20(USDC_TOKEN).balanceOf(WETH_HOLDER);

        uint256 expectedUsdcReceived = 38_569.834316e6;
        vm.expectEmit();
        emit Swapped(address(plugin), WETH_TOKEN, USDC_TOKEN, WETH_HOLDER, 9.5e18, expectedUsdcReceived);
        plugin.swapBalance(WETH_TOKEN, getCalldataScaled());

        assertEq(IERC20(WETH_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(WETH_TOKEN).balanceOf(address(WETH_HOLDER)) - startingWethBal, 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(WETH_HOLDER)) - startingUsdcBal, expectedUsdcReceived);
        assertEq(IERC20(WETH_TOKEN).allowance(address(plugin), ROUTER_V2), type(uint256).max);
    }

    function test_swapBalance_noBalance() public {
        deal(WETH_TOKEN, address(plugin), 0);
        vm.startPrank(address(bundler));
        uint256 startingWethBal = IERC20(WETH_TOKEN).balanceOf(WETH_HOLDER);
        uint256 startingUsdcBal = IERC20(USDC_TOKEN).balanceOf(WETH_HOLDER);

        plugin.swapBalance(WETH_TOKEN, getCalldataScaled());
        assertEq(IERC20(WETH_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(plugin)), 0);
        assertEq(IERC20(WETH_TOKEN).balanceOf(address(WETH_HOLDER)) - startingWethBal, 0);
        assertEq(IERC20(USDC_TOKEN).balanceOf(address(WETH_HOLDER)) - startingUsdcBal, 0);
        assertEq(IERC20(WETH_TOKEN).allowance(address(plugin), ROUTER_V2), 0);
    }
}
